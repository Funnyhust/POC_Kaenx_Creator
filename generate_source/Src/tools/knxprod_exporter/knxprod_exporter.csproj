<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KaenxLib Condition="'$(KaenxLib)' == ''">$(MSBuildProjectDirectory)\lib</KaenxLib>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Kaenx.Creator.Share">
      <HintPath>$(KaenxLib)\Kaenx.Creator.Share.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Kaenx.Creator">
      <HintPath>$(KaenxLib)\Kaenx.Creator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenKNX.Toolbox.Sign">
      <HintPath>$(KaenxLib)\OpenKNX.Toolbox.Sign.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
